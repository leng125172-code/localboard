{
  "name": "localboard",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first GitHub Project companion for humans and coding agents",
  "type": "module",
  "main": "src/desktop/main.cjs",
  "bin": {
    "localboard": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs start --foreground",
    "open": "node src/cli.mjs start",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./Install-LocalBoard.ps1",
    "daemon": "node src/daemon.mjs",
    "cli": "node src/cli.mjs",
    "test": "node --test",
    "test:ui": "node e2e/electron-ui.mjs",
    "check": "node --check src/cli.mjs && node --check src/daemon.mjs && node --check src/desktop/main.cjs && node --check src/desktop/preload.cjs && node --check src/desktop/ui/app.js && node --test"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "electron": "^44.3.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "allowScripts": {
    "electron@44.3.0": true
  }
}
