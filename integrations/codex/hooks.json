{
  "description": "Publish each Codex session's current repository context to the single LocalBoard activity sticky.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "localboard hook", "commandWindows": "localboard hook", "async": true, "timeout": 10 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "localboard hook", "commandWindows": "localboard hook", "async": true, "timeout": 10 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "localboard hook", "commandWindows": "localboard hook", "async": true, "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "localboard hook", "commandWindows": "localboard hook", "async": true, "timeout": 10 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "localboard hook", "commandWindows": "localboard hook", "timeout": 3 }] }]
  }
}
